# Environment
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
# Log levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://devuser:devpassword@localhost:5432/user_kb_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
# Comma-separated list of brokers
KAFKA_BROKERS=localhost:9094

# Security
# Must be at least 32 characters for security
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_chars_long
ENCRYPTION_KEY=super_secret_encryption_key_32_bytes_long

# OTP Security
OTP_SALT_SECRET=your_otp_salt_secret_min_16_chars

# OAuth - GitHub
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/v1/auth/github/callback

# OAuth - LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/v1/auth/linkedin/callback

# SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Core Auth Service <noreply@yourdomain.com>"


